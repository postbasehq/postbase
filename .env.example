# Postbase — environment variables
# Copy to `.env.local` (git-ignored) and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only — never expose it.
# Self-hosters bring their own platform API keys (see docs/TECH_STACK.md §4).

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000        # public base URL; use https://postbase.so in prod

# ── Supabase (Postgres · Auth · Storage) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, bypasses RLS
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Cron poller (publishes scheduled posts) ─────────────────────────
# Shared secret protecting /api/cron/publish. In production Vercel Cron sends it as a
# bearer token — set the same value in Vercel env. Generate: `openssl rand -base64 32`.
# Local dev: run the poller with `npm run poll` (it reads this from .env.local).
CRON_SECRET=your-cron-secret

# ── Secrets: token encryption & API keys ────────────────────────────
# Encrypt OAuth tokens at rest; hash API keys. See docs/TECH_STACK.md §7.
TOKEN_ENCRYPTION_KEY=generate-32-byte-base64-key   # e.g. `openssl rand -base64 32`
API_KEY_PEPPER=generate-a-long-random-string       # server-side pepper for hashing API keys

# ── X (Twitter) — OAuth 2.0 user context ────────────────────────────
# Posting requires a PAID API tier at cloud scale (docs/CRITICAL_PATH.md §3).
# Scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=your-x-oauth2-client-id
X_CLIENT_SECRET=your-x-oauth2-client-secret
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback

# ── LinkedIn ────────────────────────────────────────────────────────
# Needs a Company Page + `w_member_social` approval (the slowest gate).
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# ── Meta / Instagram (Graph API) ────────────────────────────────────
# Needs Business Verification + App Review; Business/Creator IG only.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_CALLBACK_URL=http://localhost:3000/api/auth/instagram/callback
META_GRAPH_API_VERSION=v21.0

# ── Cloudflare R2 (media library — large video/image storage) ───────
# S3-compatible object storage with zero egress fees. Create a bucket + an API
# token (Object Read & Write) in the Cloudflare dashboard, and enable public
# access (r2.dev subdomain or a custom domain) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id           # SECRET — server only
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key   # SECRET — server only
R2_BUCKET=postbase-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev         # public base URL for objects (no trailing slash)
# The bucket needs a CORS rule so the browser can PUT chunks and read the part ETag:
#   [{ "AllowedOrigins": ["http://localhost:3000", "https://postbase.so"],
#      "AllowedMethods": ["PUT"], "AllowedHeaders": ["*"], "ExposeHeaders": ["ETag"] }]

# ── Email (later — notifications) ───────────────────────────────────
# RESEND_API_KEY=your-resend-key
# EMAIL_FROM=team@postbase.so
