# Postbase — environment variables
# Copy to `.env.local` (git-ignored) and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only — never expose it.
# Self-hosters bring their own platform API keys (see docs/TECH_STACK.md §4).

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000        # public base URL; use https://postbase.so in prod

# ── Supabase (Postgres · Auth · Storage) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, bypasses RLS
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Cron poller (publishes scheduled posts) ─────────────────────────
# Shared secret protecting /api/cron/publish. In production Vercel Cron sends it as a
# bearer token — set the same value in Vercel env. Generate: `openssl rand -base64 32`.
# Local dev: run the poller with `npm run poll` (it reads this from .env.local).
CRON_SECRET=your-cron-secret

# ── Secrets: token encryption & API keys ────────────────────────────
# Encrypt OAuth tokens at rest; hash API keys. See docs/TECH_STACK.md §7.
TOKEN_ENCRYPTION_KEY=generate-32-byte-base64-key   # e.g. `openssl rand -base64 32`
API_KEY_PEPPER=generate-a-long-random-string       # server-side pepper for hashing API keys

# ── X (Twitter) — OAuth 2.0 user context ────────────────────────────
# Posting requires a PAID API tier at cloud scale (docs/CRITICAL_PATH.md §3).
# Scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=your-x-oauth2-client-id
X_CLIENT_SECRET=your-x-oauth2-client-secret
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
# DISABLE_X_ANALYTICS=1                           # stop reading X stats (X bills each read)

# ── LinkedIn ────────────────────────────────────────────────────────
# Needs a Company Page + `w_member_social` approval (the slowest gate).
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback
# LINKEDIN_API_VERSION=202609                     # optional override (YYYYMM)

# ── Meta / Instagram (Graph API) ────────────────────────────────────
# Needs Business Verification + App Review; Business/Creator IG only.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_CALLBACK_URL=http://localhost:3000/api/auth/instagram/callback
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
# META_GRAPH_API_VERSION=v25.0                    # optional override

# ── TikTok (Content Posting API) ────────────────────────────────────
# Direct Post needs TikTok's audit; until then posts can only be private.
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_CALLBACK_URL=http://localhost:3000/api/auth/tiktok/callback
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY                  # hard cap for unaudited apps; unset once audited

# ── YouTube (Data API v3) ───────────────────────────────────────────
# Uploads above the default quota need Google's audit (videos.insert).
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_CALLBACK_URL=http://localhost:3000/api/auth/youtube/callback
# YOUTUBE_PRIVACY_STATUS=public                   # default when a post doesn't choose one

# Bluesky (app passwords) and Mastodon (per-instance apps, registered at
# connect time) need no keys. Who may connect networks still waiting on
# platform approval: comma-separated emails.
# EARLY_ACCESS_EMAILS=you@example.com

# ── Cloudflare R2 (media library — large video/image storage) ───────
# S3-compatible object storage with zero egress fees. Create a bucket + an API
# token (Object Read & Write) in the Cloudflare dashboard, and enable public
# access (r2.dev subdomain or a custom domain) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id           # SECRET — server only
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key   # SECRET — server only
R2_BUCKET=postbase-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev         # public base URL for objects (no trailing slash)
# The bucket needs a CORS rule so the browser can PUT chunks and read the part ETag:
#   [{ "AllowedOrigins": ["http://localhost:3000", "https://postbase.so"],
#      "AllowedMethods": ["PUT"], "AllowedHeaders": ["*"], "ExposeHeaders": ["ETag"] }]

# Local development only: enforce plans without Stripe configured (see lib/billing-guard.ts).
# FORCE_BILLING=1

# ── Transactional email (Resend) ─────────────────────────────────────────
# Post failed, reconnect needed, team invites, welcome, billing notices.
# Without a key these are skipped and nothing else changes. The sending
# domain (postbase.so) must be verified in Resend.
RESEND_API_KEY=
# Optional: defaults to "Postbase <noreply@postbase.so>" / team@postbase.so
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Monitoring ───────────────────────────────────────────────────────────
# Sentry (errors only; off when unset). Auth token/org/project are only for
# uploading source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Healthchecks.io ping URL for the publish cron (alerts when runs stop).
HEALTHCHECK_PUBLISH_URL=
# Where publishing-health alerts go (default team@postbase.so).
OPS_ALERT_EMAIL=

# ── Billing (Stripe) ─────────────────────────────────────────────────────
# Plans are enforced only when the secret, webhook secret and the Creator
# monthly price are all set; without them every workspace has full access
# (self-hosting). Webhook endpoint: /api/stripe/webhook, events
# customer.subscription.{created,updated,deleted,trial_will_end} and
# invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=
# STRIPE_MANAGED_PAYMENTS=off                     # opt out of Stripe Managed Payments at checkout

# ── AI ───────────────────────────────────────────────────────────────────
# The /agent chat. Models only show when their provider's key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AGENT_MODEL=claude-sonnet-5                     # default model id
# Image/video generation in the composer (off when unset).
HIGGSFIELD_API_KEY=
# HIGGSFIELD_VIDEO_MODEL=kling-video/v2.6/pro

# ── Misc (optional) ──────────────────────────────────────────────────────
# MCP_HOST=mcp.postbase.so                        # host that serves the MCP server at /
# GITHUB_TOKEN=                                   # raises the rate limit for the GitHub stars badge
# NEXT_PUBLIC_GA_ID=                              # Google Analytics id for the marketing site
# SENTRY_DSN=                                     # server-side DSN, if different from NEXT_PUBLIC_SENTRY_DSN
